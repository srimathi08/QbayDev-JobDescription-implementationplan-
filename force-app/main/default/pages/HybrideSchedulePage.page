<apex:page controller="HybridWorkScheduleApprovalController" sidebar="false" showHeader="false" cache="false">
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }

        body {
            font-family: 'Salesforce Sans', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.25);
            max-width: 700px;
            width: 100%;
            overflow: hidden;
            animation: slideIn 0.5s ease-out;
        }

        @keyframes slideIn {
            from { opacity:0; transform:translateY(30px); }
            to   { opacity:1; transform:translateY(0); }
        }

        .header {
            background: linear-gradient(135deg, #0176d3 0%, #0d4f8b 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top:-50%; right:-50%;
            width:200%; height:200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: pulse 3s ease-in-out infinite;
        }

        @keyframes pulse {
            0%,100% { transform:scale(1); opacity:0.5; }
            50%      { transform:scale(1.1); opacity:0.8; }
        }

        .header h1 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 8px;
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
        }

        .header-subtitle {
            font-size: 16px;
            opacity: 0.95;
            position: relative;
            z-index: 1;
        }

        .content {
            padding: 40px 35px;
            background: #f9fafb;
        }

        .info-card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e5e7eb;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .info-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }

        .card-title {
            font-size: 18px;
            font-weight: 700;
            color: #0176d3;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 3px solid #0176d3;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-title::before { content:'📋'; font-size:22px; }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid #f0f1f3;
            transition: background 0.2s ease;
        }

        .detail-row:hover {
            background: #f9fafb;
            padding-left:10px; padding-right:10px;
            margin-left:-10px; margin-right:-10px;
            border-radius: 8px;
        }

        .detail-row:last-child { border-bottom: none; }

        .detail-label {
            font-weight: 600;
            color: #4b5563;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .detail-label::before { content:'•'; color:#0176d3; font-size:20px; }

        .detail-value {
            color: #1f2937;
            font-weight: 600;
            font-size: 15px;
            background: #f3f4f6;
            padding: 8px 16px;
            border-radius: 8px;
            border-left: 3px solid #0176d3;
        }

        .status-badge {
            display: inline-block;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-pending   { background:#fff8e1; color:#f57c00; border:2px solid #ffb74d; }
        .status-rejected  { background:#ffebee; color:#c62828; border:2px solid #ef5350; }
        .status-approved  { background:#e8f5e9; color:#2e7d32; border:2px solid #66bb6a; }
        .status-cancelled { background:#f5f5f5; color:#616161; border:2px solid #9e9e9e; }

        .reason-section {
            background: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e5e7eb;
            border-left: 5px solid #f59e0b;
        }

        .reason-title {
            font-size: 16px;
            font-weight: 700;
            color: #f59e0b;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .reason-title::before { content:'💬'; font-size:20px; }

        .reason-text {
            background: #fffbeb;
            padding: 18px;
            border-radius: 10px;
            color: #78350f;
            line-height: 1.7;
            font-size: 14px;
            border: 1px solid #fde68a;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            justify-content: center;
        }

        .btn {
            flex: 1;
            max-width: 200px;
            padding: 16px 30px;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

        .btn::before {
            content: '';
            position: absolute;
            top:0; left:-100%;
            width:100%; height:100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
        }

        .btn:hover::before { left:100%; }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        }

        .btn:active { transform: translateY(0); }

        .btn-approve { background: linear-gradient(135deg, #2e844a 0%, #1e5f35 100%); color:white; }
        .btn-reject  { background: linear-gradient(135deg, #d32f2f 0%, #9a1f1f 100%); color:white; }

        /* Message Boxes */
        .message-box {
            background: white;
            border-radius: 16px;
            padding: 35px 25px;
            text-align: center;
            font-weight: 600;
            font-size: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e5e7eb;
            margin: 10px 0;
        }

        .success-approve {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            color: #2e7d32;
            border-left: 6px solid #2e7d32;
        }

        .success-reject {
            background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
            color: #e65100;
            border-left: 6px solid #f57c00;
        }

        .info-box {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            color: #1565c0;
            border-left: 6px solid #1565c0;
        }

        .error-box {
            background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
            color: #c62828;
            border-left: 6px solid #c62828;
        }

        .icon-large { font-size:48px; margin-bottom:15px; display:block; }
        .message-box h3 { font-size:22px; margin-bottom:10px; }
        .message-box p  { font-size:15px; margin:6px 0; opacity:0.9; }
        .close-note { margin-top:18px !important; font-size:13px !important; opacity:0.7 !important; font-style:italic; }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top:0; left:0;
            width:100%; height:100%;
            background: rgba(0,0,0,0.6);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }

        .modal-box {
            background: white;
            border-radius: 16px;
            padding: 35px;
            max-width: 450px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            animation: slideIn 0.3s ease-out;
        }

        .modal-title    { color:#d32f2f; font-size:20px; font-weight:700; margin-bottom:8px; }
        .modal-subtitle { color:#6b7280; font-size:14px; margin-bottom:20px; }

        .modal-textarea {
            width: 100%;
            min-height: 120px;
            padding: 12px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            font-size: 14px;
            font-family: inherit;
            resize: vertical;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

        .modal-textarea:focus { outline:none; border-color:#d32f2f; }

        .modal-error { color:#d32f2f; font-size:13px; margin-top:6px; display:none; }

        .modal-actions {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: flex-end;
        }

        .btn-modal-cancel {
            padding: 12px 24px;
            border: 2px solid #e5e7eb;
            background: white;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            color: #6b7280;
            font-size: 14px;
            transition: all 0.2s;
        }

        .btn-modal-cancel:hover { background:#f3f4f6; }

        .btn-modal-confirm {
            padding: 12px 24px;
            background: #d32f2f;
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
            font-size: 14px;
            transition: all 0.2s;
        }

        .btn-modal-confirm:hover { background:#9a1f1f; }

        .footer {
            background: #f3f4f6;
            padding: 20px 30px;
            text-align: center;
            color: #6b7280;
            font-size: 13px;
            border-top: 1px solid #e5e7eb;
        }

        @media (max-width: 600px) {
            body { padding:20px 10px; }
            .container { border-radius:16px; }
            .header { padding:30px 20px; }
            .header h1 { font-size:26px; }
            .content { padding:30px 20px; }
            .info-card { padding:20px; }
            .detail-row { flex-direction:column; align-items:flex-start; gap:8px; padding:14px 0; }
            .detail-value { width:100%; }
            .action-buttons { flex-direction:column; }
            .btn { max-width:100%; }
        }
    </style>

    <script>
        function openRejectModal() {
            document.getElementById('rejectModal').style.display = 'flex';
            document.getElementById('rejectionReasonText').focus();
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
            document.getElementById('rejectionReasonText').value = '';
            document.getElementById('reasonError').style.display = 'none';
            document.getElementById('rejectionReasonText').style.borderColor = '#e5e7eb';
        }

        function confirmHybridReject() {
            var reason = document.getElementById('rejectionReasonText').value.trim();

            if (!reason) {
                document.getElementById('reasonError').style.display = 'block';
                document.getElementById('rejectionReasonText').style.borderColor = '#d32f2f';
                return;
            }

            // Copy to bound hidden Apex field
            var hiddenField = document.querySelector("[id$='rejectionReasonHidden']");
            if (hiddenField) {
                hiddenField.value = reason;
            }

            // Close modal and fire hidden Apex commandButton
            document.getElementById('rejectModal').style.display = 'none';
            document.querySelector("[id$='rejectBtn']").click();
        }

        // Close modal when clicking the backdrop
        window.addEventListener('DOMContentLoaded', function () {
            document.getElementById('rejectModal').addEventListener('click', function (e) {
                if (e.target === this) closeRejectModal();
            });
        });
    </script>
</head>

<body>
<div class="container">
    <apex:form id="mainForm">

        <!-- HEADER -->
        <div class="header">
            <h1>Hybrid Work Schedule Approval</h1>
            <p class="header-subtitle">Manager Review And Decision</p>
        </div>

        <div class="content">

            <!-- ===== SUCCESS: APPROVED ===== -->
            <apex:outputPanel rendered="{!AND(showSuccess, actionTaken == 'Approved')}">
                <div class="message-box success-approve">
                    <span class="icon-large">✅</span>
                    <h3>Hybrid Schedule Approved!</h3>
                    <p>The hybrid work schedule for <strong>{!employeeName}</strong> has been successfully approved.</p>
                    <p>A confirmation email has been sent to the employee.</p>
                    <p class="close-note">You may now close this window.</p>
                </div>
            </apex:outputPanel>

            <!-- ===== SUCCESS: REJECTED ===== -->
            <apex:outputPanel rendered="{!AND(showSuccess, actionTaken == 'Rejected')}">
                <div class="message-box success-reject">
                    <span class="icon-large">❌</span>
                    <h3>Hybrid Schedule Rejected</h3>
                    <p>The hybrid work schedule request has been rejected with the provided reason.</p>
                    <p>A notification email has been sent to the employee.</p>
                    <p class="close-note">You may now close this window.</p>
                </div>
            </apex:outputPanel>

            <!-- ===== ALREADY PROCESSED ===== -->
            <apex:outputPanel rendered="{!AND(showInfo, NOT(showSuccess), NOT(showError))}">
                <div class="message-box info-box">
                    <span class="icon-large">ℹ️</span>
                    <h3>Already Processed</h3>
                    <p>{!infoMessage}</p>
                    <p class="close-note">This link is no longer valid. You may close this window.</p>
                </div>
            </apex:outputPanel>

            <!-- ===== ERROR ===== -->
            <apex:outputPanel rendered="{!showError}">
                <div class="message-box error-box">
                    <span class="icon-large">⚠️</span>
                    <h3>Error</h3>
                    <p>{!errorMessage}</p>
                </div>
            </apex:outputPanel>

            <!-- ===== MAIN FORM ===== -->
            <apex:outputPanel rendered="{!AND(hybridWorkSchedule != null, NOT(showSuccess), NOT(showError), NOT(showInfo))}">

                <div class="info-card">
                    <h2 class="card-title">Request Details</h2>

                    <div class="detail-row">
                        <span class="detail-label">Employee Name</span>
                        <span class="detail-value">{!employeeName}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">{!employeeEmail}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Schedule Type</span>
                        <span class="detail-value">{!hybridWorkSchedule.Schedule_Type__c}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">WFH Days</span>
                        <span class="detail-value">{!wfhDays}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Office Days</span>
                        <span class="detail-value">{!officeDays}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Total WFH Days</span>
                        <span class="detail-value">{!hybridWorkSchedule.Total_WFH_Days__c} Days</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Total Office Days</span>
                        <span class="detail-value">{!hybridWorkSchedule.Total_Office_Days__c} Days</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Status</span>
                        <span class="detail-value">
                            <span class="status-badge status-pending">Pending</span>
                        </span>
                    </div>
                </div>

                <div class="reason-section">
                    <h3 class="reason-title">Reason for Request</h3>
                    <div class="reason-text">{!reason}</div>
                </div>

                <div class="action-buttons">

                    <!-- APPROVE -->
                    <apex:commandButton value="✔ Approve"
                        action="{!approveRequest}"
                        styleClass="btn btn-approve"
                        reRender="mainForm"/>

                    <!-- REJECT (opens modal) -->
                    <button type="button"
                            class="btn btn-reject"
                            onclick="openRejectModal(); return false;">
                        ✖ Reject
                    </button>

                </div>

                <!-- Hidden field bound to rejectionReason -->
                <apex:inputHidden value="{!rejectionReason}" id="rejectionReasonHidden"/>

                <!-- Hidden commandButton triggered by JS -->
                <apex:commandButton id="rejectBtn"
                    value="RejectHidden"
                    action="{!rejectRequest}"
                    style="display:none;"
                    reRender="mainForm"/>

                <apex:pageMessages />

            </apex:outputPanel>

            <!-- ===== INVALID LINK ===== -->
            <apex:outputPanel rendered="{!AND(hybridWorkSchedule == null, NOT(showSuccess), NOT(showError), NOT(showInfo))}">
                <div class="message-box error-box">
                    <span class="icon-large">🔗</span>
                    <h3>Invalid Link</h3>
                    <p>This hybrid work schedule link is invalid or no longer available.</p>
                    <p class="close-note">You may close this window.</p>
                </div>
            </apex:outputPanel>

        </div><!-- /content -->

        <div class="footer">
            <p>&copy; 2026 Attendance Management System • All Rights Reserved</p>
        </div>

    </apex:form>

    <!-- REJECTION MODAL (outside apex:form to avoid nesting issues) -->
    <div id="rejectModal" class="modal-overlay">
        <div class="modal-box">
            <div class="modal-title">❌ Provide Rejection Reason</div>
            <p class="modal-subtitle">
                Please explain why this hybrid work schedule request is being rejected.
                This will be shared with the employee.
            </p>

            <textarea id="rejectionReasonText"
                      class="modal-textarea"
                      placeholder="Enter rejection reason here..."></textarea>

            <p id="reasonError" class="modal-error">⚠️ Rejection reason is required.</p>

            <div class="modal-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeRejectModal()">
                    Cancel
                </button>
                <button type="button" class="btn-modal-confirm" onclick="confirmHybridReject()">
                    Confirm Reject
                </button>
            </div>
        </div>
    </div>

</div><!-- /container -->
</body>
</html>
</apex:page>