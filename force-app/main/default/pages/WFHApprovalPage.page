<apex:page controller="WFHApprovalController" sidebar="false" showHeader="false" cache="false">
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;display=swap');

        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'DM Sans', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.25);
            max-width: 620px;
            width: 100%;
            overflow: hidden;
            animation: slideIn 0.4s ease-out;
        }
        @keyframes slideIn {
            from { opacity:0; transform:translateY(20px); }
            to   { opacity:1; transform:translateY(0); }
        }

        /* ── HEADERS ── */
        .header-manager {
            background: linear-gradient(135deg, #0176d3 0%, #0d4f8b 100%);
            color: white; padding: 22px 28px; text-align: center;
        }
        .header-hr {
            background: linear-gradient(135deg, #7b5ea7 0%, #4a3580 100%);
            color: white; padding: 22px 28px; text-align: center;
        }
        .header-manager h1, .header-hr h1 {
            font-size: 22px; font-weight: 700; margin-bottom: 4px;
        }
        .header-subtitle { font-size: 13px; opacity: 0.9; }
        .level-badge {
            display: inline-block; padding: 4px 14px;
            border-radius: 20px; font-size: 12px; font-weight: 700;
            margin-top: 8px; background: rgba(255,255,255,0.25);
            border: 1.5px solid rgba(255,255,255,0.6); color: white;
        }

        /* ── PROGRESS STEPS ── */
        .progress-steps {
            display: flex; align-items: center; justify-content: center;
            padding: 14px 28px; background: #f9fafb;
            border-bottom: 1px solid #e5e7eb; gap: 0;
        }
        .step { display: flex; flex-direction: column; align-items: center; gap: 5px; flex: 1; }
        .step-circle {
            width: 32px; height: 32px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 13px; border: 2px solid;
        }
        .step-circle-done            { background:#e8f5e9; border-color:#2e7d32; color:#2e7d32; }
        .step-circle-active-manager  { background:#0176d3; border-color:#0176d3; color:white; }
        .step-circle-active-hr       { background:#7b5ea7; border-color:#7b5ea7; color:white; }
        .step-circle-pending         { background:#f3f4f6; border-color:#d1d5db; color:#9ca3af; }
        .step-label { font-size:10px; font-weight:600; text-align:center; text-transform:uppercase; letter-spacing:0.3px; }
        .step-label-done    { color:#2e7d32; }
        .step-label-active  { color:#1f2937; }
        .step-label-pending { color:#9ca3af; }
        .step-connector { height:2px; flex:1; margin-bottom:20px; }
        .step-connector-done    { background:#2e7d32; }
        .step-connector-pending { background:#e5e7eb; }

        /* ── CONTENT ── */
        .content { padding: 20px 24px; background: #f9fafb; }

        /* ── COMPACT GRID TABLE ── */
        .details-grid {
            background: white; border-radius: 14px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            overflow: hidden; margin-bottom: 14px;
        }
        .grid-header {
            padding: 12px 18px;
            font-size: 13px; font-weight: 700; color: #0176d3;
            border-bottom: 2px solid #0176d3;
            display: flex; align-items: center; gap: 8px;
            background: #f0f7ff;
        }
        .grid-header-hr { color: #7b5ea7; border-bottom-color: #7b5ea7; background: #f5f0fa; }
        .grid-row {
            display: grid; grid-template-columns: 1fr 1fr;
            border-bottom: 1px solid #f0f1f3;
        }
        .grid-row:last-child { border-bottom: none; }
        .grid-cell {
            padding: 14px 18px;
            border-right: 1px solid #f0f1f3;
        }
        .grid-cell:last-child { border-right: none; }
        .cell-label {
            font-size: 10px; font-weight: 700; color: #6b7280;
            text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 5px;
        }
        .cell-value {
            font-size: 14px; font-weight: 600; color: #1f2937;
        }
        .cell-value-large {
            font-size: 13px; font-weight: 500; color: #374151; line-height: 1.5;
        }

        /* ── FULL-WIDTH CELL (for reason row spanning both cols) ── */
        .grid-row-full .grid-cell { grid-column: 1 / -1; border-right: none; }

        /* ── STATUS BADGES ── */
        .status-badge {
            display:inline-block; padding:4px 12px; border-radius:20px;
            font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;
        }
        .status-pending    { background:#fff8e1; color:#f57c00; border:1.5px solid #ffb74d; }
        .status-pending-hr { background:#f0eafa; color:#7b5ea7; border:1.5px solid #b39ddb; }

        /* ── MANAGER DECISION CARD ── */
        .manager-decision-card {
            background:white; border-radius:14px; padding:16px 18px; margin-bottom:14px;
            box-shadow:0 2px 12px rgba(0,0,0,0.06); border:1px solid #e5e7eb;
            border-left:4px solid #2e7d32;
        }
        .manager-decision-title {
            font-size:13px; font-weight:700; color:#2e7d32;
            margin-bottom:12px; display:flex; align-items:center; gap:6px;
        }
        .manager-decision-title::before { content:'✅'; font-size:16px; }
        .manager-approved-badge {
            display:inline-block; background:#e8f5e9; color:#2e7d32;
            border:1.5px solid #66bb6a; padding:3px 12px;
            border-radius:20px; font-size:11px; font-weight:700; text-transform:uppercase;
        }
        .manager-comments-box {
            background:#f0fdf4; border:1px solid #bbf7d0; border-radius:8px;
            padding:10px 14px; color:#166534; font-size:13px; margin-top:8px;
            font-style:italic; line-height:1.5;
        }
        .manager-comments-empty {
            background:#f9fafb; border:1px solid #e5e7eb; border-radius:8px;
            padding:8px 12px; color:#9ca3af; font-size:12px; margin-top:8px; font-style:italic;
        }
        .mini-row {
            display:flex; justify-content:space-between; align-items:center;
            padding:6px 0; border-bottom:1px solid #f0f1f3; font-size:13px;
        }
        .mini-row:last-child { border-bottom:none; }
        .mini-label { font-weight:600; color:#6b7280; font-size:11px; text-transform:uppercase; letter-spacing:0.4px; }

        /* ── APPROVAL COMMENTS ── */
        .comments-section-manager {
            background:white; border-radius:14px; padding:14px 18px; margin-bottom:14px;
            box-shadow:0 2px 12px rgba(0,0,0,0.06); border:1px solid #e5e7eb;
            border-left:4px solid #0176d3;
        }
        .comments-section-hr {
            background:white; border-radius:14px; padding:14px 18px; margin-bottom:14px;
            box-shadow:0 2px 12px rgba(0,0,0,0.06); border:1px solid #e5e7eb;
            border-left:4px solid #7b5ea7;
        }
        .comments-title-manager { font-size:13px; font-weight:700; color:#0176d3; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
        .comments-title-hr      { font-size:13px; font-weight:700; color:#7b5ea7; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
        .comments-textarea {
            width:100%; min-height:70px; padding:10px;
            border:1.5px solid #e5e7eb; border-radius:10px;
            font-size:13px; font-family:inherit; resize:vertical;
            box-sizing:border-box; transition:border-color 0.2s;
            color:#1f2937; background:#fafafa;
        }
        .comments-textarea:focus { outline:none; border-color:#0176d3; background:white; }
        .comments-textarea-hr:focus { border-color:#7b5ea7; }
        .comments-note { font-size:11px; color:#6b7280; margin-top:6px; display:flex; align-items:center; gap:4px; }

        /* ── ACTION BUTTONS ── */
        .action-buttons { display:flex; gap:12px; margin-top:4px; justify-content:center; }
        .btn {
            flex:1; max-width:220px; padding:13px 20px; border:none; border-radius:10px;
            font-size:13px; font-weight:700; cursor:pointer; transition:all 0.25s ease;
            text-transform:uppercase; letter-spacing:0.8px;
            box-shadow:0 3px 12px rgba(0,0,0,0.15);
        }
        .btn:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,0.2); }
        .btn:active { transform:translateY(0); }
        .btn-approve       { background:linear-gradient(135deg,#2e844a 0%,#1e5f35 100%); color:white; }
        .btn-approve-final { background:linear-gradient(135deg,#7b5ea7 0%,#4a3580 100%); color:white; }
        .btn-reject        { background:linear-gradient(135deg,#d32f2f 0%,#9a1f1f 100%); color:white; }

        /* ── MESSAGE BOXES ── */
        .message-box {
            border-radius:14px; padding:28px 20px; text-align:center;
            font-weight:600; font-size:15px;
            box-shadow:0 3px 15px rgba(0,0,0,0.07); margin:8px 0;
        }
        .success-approve { background:linear-gradient(135deg,#e8f5e9 0%,#c8e6c9 100%); color:#2e7d32; border-left:5px solid #2e7d32; }
        .success-reject  { background:linear-gradient(135deg,#fff3e0 0%,#ffe0b2 100%); color:#e65100; border-left:5px solid #f57c00; }
        .info-box  { background:linear-gradient(135deg,#e3f2fd 0%,#bbdefb 100%); color:#1565c0; border-left:5px solid #1565c0; }
        .error-box { background:linear-gradient(135deg,#ffebee 0%,#ffcdd2 100%); color:#c62828; border-left:5px solid #c62828; }
        .icon-large { font-size:40px; margin-bottom:12px; display:block; }
        .message-box h3 { font-size:19px; margin-bottom:8px; }
        .message-box p  { font-size:14px; margin:5px 0; opacity:0.9; }
        .close-note { margin-top:14px !important; font-size:12px !important; opacity:0.7 !important; font-style:italic; }

        /* ── MODAL ── */
        .modal-overlay {
            display:none; position:fixed; top:0; left:0;
            width:100%; height:100%; background:rgba(0,0,0,0.6);
            z-index:9999; justify-content:center; align-items:center;
        }
        .modal-box {
            background:white; border-radius:16px; padding:28px;
            max-width:420px; width:90%;
            box-shadow:0 20px 60px rgba(0,0,0,0.3); animation:slideIn 0.3s ease-out;
        }
        .modal-title    { color:#d32f2f; font-size:18px; font-weight:700; margin-bottom:6px; }
        .modal-subtitle { color:#6b7280; font-size:13px; margin-bottom:16px; }
        .modal-textarea {
            width:100%; min-height:110px; padding:11px;
            border:1.5px solid #e5e7eb; border-radius:10px; font-size:13px;
            font-family:inherit; resize:vertical; box-sizing:border-box; transition:border-color 0.2s;
        }
        .modal-textarea:focus { outline:none; border-color:#d32f2f; }
        .modal-error { color:#d32f2f; font-size:12px; margin-top:5px; display:none; }
        .modal-actions { display:flex; gap:10px; margin-top:16px; justify-content:flex-end; }
        .btn-modal-cancel {
            padding:10px 20px; border:1.5px solid #e5e7eb; background:white;
            border-radius:9px; cursor:pointer; font-weight:600; color:#6b7280; font-size:13px; transition:all 0.2s;
        }
        .btn-modal-cancel:hover { background:#f3f4f6; }
        .btn-modal-confirm {
            padding:10px 20px; background:#d32f2f; color:white; border:none;
            border-radius:9px; cursor:pointer; font-weight:700; font-size:13px; transition:all 0.2s;
        }
        .btn-modal-confirm:hover { background:#9a1f1f; }

        .footer { background:#f3f4f6; padding:12px 28px; text-align:center; color:#9ca3af; font-size:12px; border-top:1px solid #e5e7eb; }

        @media (max-width:520px) {
            body { padding:12px; }
            .grid-row { grid-template-columns: 1fr; }
            .grid-cell { border-right:none; border-bottom:1px solid #f0f1f3; }
            .action-buttons { flex-direction:column; }
            .btn { max-width:100%; }
        }
    </style>
    <script>
        function openRejectModal() {
            document.getElementById('rejectModal').style.display = 'flex';
            document.getElementById('rejectionReasonText').focus();
        }
        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
            document.getElementById('rejectionReasonText').value = '';
            document.getElementById('reasonError').style.display = 'none';
            document.getElementById('rejectionReasonText').style.borderColor = '#e5e7eb';
        }
        function confirmReject() {
            var reason = document.getElementById('rejectionReasonText').value.trim();
            if (!reason) {
                document.getElementById('reasonError').style.display = 'block';
                document.getElementById('rejectionReasonText').style.borderColor = '#d32f2f';
                return;
            }
            var hiddenField = document.querySelector("[id$='rejectionReasonHidden']");
            if (hiddenField) { hiddenField.value = reason; }
            document.getElementById('rejectModal').style.display = 'none';
            document.querySelector("[id$='rejectBtn']").click();
        }
        window.addEventListener('DOMContentLoaded', function () {
            document.getElementById('rejectModal').addEventListener('click', function (e) {
                if (e.target === this) closeRejectModal();
            });
        });
    </script>
</head>
<body>
<div class="container">
<apex:form id="mainForm">

    <!-- ============================================================
         HEADERS
    ============================================================ -->
    <apex:outputPanel rendered="{!AND(wfh != null, isManagerLevel, NOT(isTwoLevelApproval), NOT(showSuccess), NOT(showError), NOT(showInfo))}">
        <div class="header-manager">
            <h1>WFH Request Approval</h1>
        </div>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!AND(wfh != null, isManagerLevel, isTwoLevelApproval, NOT(showSuccess), NOT(showError), NOT(showInfo))}">
        <div class="header-manager">
            <h1>WFH Request Approval</h1>
            <p class="header-subtitle">Review and make your decision</p>
            <span class="level-badge">&#9312; Level 1 – Manager Approval</span>
        </div>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!AND(wfh != null, isHRLevel, NOT(showSuccess), NOT(showError), NOT(showInfo))}">
        <div class="header-hr">
            <h1>WFH Request – Final Approval</h1>
            <p class="header-subtitle">Manager has approved — your final decision is required</p>
            <span class="level-badge">&#9313; Level 2 – HR Final Approval</span>
        </div>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!OR(showSuccess, showError, showInfo, wfh == null)}">
        <div class="header-manager">
            <h1>WFH Request Approval</h1>
            <p class="header-subtitle">HR Management System</p>
        </div>
    </apex:outputPanel>

    <!-- ============================================================
         PROGRESS STEPS
    ============================================================ -->
    <apex:outputPanel rendered="{!AND(wfh != null, isTwoLevelApproval, NOT(showSuccess), NOT(showError), NOT(showInfo))}">
        <div class="progress-steps">
            <div class="step">
                <div class="{!IF(isHRLevel, 'step-circle step-circle-done', 'step-circle step-circle-active-manager')}">
                    <apex:outputText value="✓" rendered="{!isHRLevel}"/>
                    <apex:outputText value="1" rendered="{!isManagerLevel}"/>
                </div>
                <span class="{!IF(isHRLevel, 'step-label step-label-done', 'step-label step-label-active')}">Manager</span>
            </div>
            <div class="{!IF(isHRLevel, 'step-connector step-connector-done', 'step-connector step-connector-pending')}"></div>
            <div class="step">
                <div class="{!IF(isHRLevel, 'step-circle step-circle-active-hr', 'step-circle step-circle-pending')}">2</div>
                <span class="{!IF(isHRLevel, 'step-label step-label-active', 'step-label step-label-pending')}">HR Final</span>
            </div>
        </div>
    </apex:outputPanel>

    <div class="content">

        <!-- SUCCESS: APPROVED -->
        <apex:outputPanel rendered="{!AND(showSuccess, actionTaken == 'Approved')}">
            <div class="message-box success-approve">
                <span class="icon-large">✅</span>
                <h3>WFH Request Approved!</h3>
                <p>The WFH request for <strong>{!employeeName}</strong> has been approved.</p>
                <apex:outputPanel rendered="{!AND(isManagerLevel, isTwoLevelApproval)}">
                    <p style="color:#1565c0; font-size:12px; margin-top:6px;">&#9432; This request has been forwarded to HR for final approval.</p>
                </apex:outputPanel>
                <p>A notification email has been sent.</p>
                <p class="close-note">You may now close this window.</p>
            </div>
        </apex:outputPanel>

        <!-- SUCCESS: REJECTED -->
        <apex:outputPanel rendered="{!AND(showSuccess, actionTaken == 'Rejected')}">
            <div class="message-box success-reject">
                <span class="icon-large">❌</span>
                <h3>WFH Request Rejected</h3>
                <p>The WFH request has been rejected with the provided reason.</p>
                <p>A notification email has been sent to the employee.</p>
                <p class="close-note">You may now close this window.</p>
            </div>
        </apex:outputPanel>

        <!-- ALREADY PROCESSED -->
        <apex:outputPanel rendered="{!AND(showInfo, NOT(showSuccess), NOT(showError))}">
            <div class="message-box info-box">
                <span class="icon-large">ℹ️</span>
                <h3>Already Processed</h3>
                <p>{!infoMessage}</p>
                <p class="close-note">This link is no longer valid. You may close this window.</p>
            </div>
        </apex:outputPanel>

        <!-- ERROR -->
        <apex:outputPanel rendered="{!showError}">
            <div class="message-box error-box">
                <span class="icon-large">⚠️</span>
                <h3>Error</h3>
                <p>{!errorMessage}</p>
            </div>
        </apex:outputPanel>

        <!-- ============================================================
             MAIN FORM
        ============================================================ -->
        <apex:outputPanel rendered="{!AND(wfh != null, NOT(showSuccess), NOT(showError), NOT(showInfo))}">

            <!-- ── COMPACT 2×2 GRID TABLE ── -->
            <div class="details-grid">
                <div class="{!IF(isHRLevel, 'grid-header grid-header-hr', 'grid-header')}">
                    📋 WFH Request Details
                </div>

                <!-- Row 1: Employee Name | Number of Days -->
                <div class="grid-row">
                    <div class="grid-cell">
                        <div class="cell-label">Employee Name</div>
                        <div class="cell-value">{!employeeName}</div>
                    </div>
                    <div class="grid-cell">
                        <div class="cell-label">Number of Days</div>
                        <div class="cell-value">{!numberOfDays} Days</div>
                    </div>
                </div>

                <!-- Row 2: Status | Reason for WFH -->
                <div class="grid-row">
                    <div class="grid-cell">
                        <div class="cell-label">Status</div>
                        <div class="cell-value" style="margin-top:2px;">
                            <apex:outputPanel rendered="{!AND(isManagerLevel, NOT(isTwoLevelApproval))}">
                                <span class="status-badge status-pending">Pending Approval</span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!AND(isManagerLevel, isTwoLevelApproval)}">
                                <span class="status-badge status-pending">Pending Level 1</span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!isHRLevel}">
                                <span class="status-badge status-pending-hr">Pending HR</span>
                            </apex:outputPanel>
                        </div>
                    </div>
                    <div class="grid-cell">
                        <div class="cell-label">Reason for WFH</div>
                        <div class="cell-value-large">{!reason}</div>
                    </div>
                </div>
            </div>

            <!-- ── MANAGER DECISION CARD — shown to HR only ── -->
            <apex:outputPanel rendered="{!isHRLevel}">
                <div class="manager-decision-card">
                    <div class="manager-decision-title">Level 1 – Manager Decision</div>
                    <div class="mini-row">
                        <span class="mini-label">Manager</span>
                        <span style="font-weight:600; color:#1f2937; font-size:13px;">{!managerName}</span>
                    </div>
                    <div class="mini-row">
                        <span class="mini-label">Decision</span>
                        <span class="manager-approved-badge">✓ Approved</span>
                    </div>
                    <apex:outputPanel rendered="{!NOT(ISBLANK(managerComments))}">
                        <div style="margin-top:10px;">
                            <div style="font-size:11px; font-weight:600; color:#4b5563; text-transform:uppercase; letter-spacing:0.4px; margin-bottom:6px;">💬 Manager Comments</div>
                            <div class="manager-comments-box">{!managerComments}</div>
                        </div>
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!ISBLANK(managerComments)}">
                        <div class="manager-comments-empty">No comments provided by Manager.</div>
                    </apex:outputPanel>
                </div>
            </apex:outputPanel>

            <!-- ── APPROVAL COMMENTS — Manager ── -->
            <apex:outputPanel rendered="{!isManagerLevel}">
                <div class="comments-section-manager">
                    <div class="comments-title-manager">
                        💬 Approval Comments
                        <span style="font-size:11px; font-weight:400; color:#6b7280;">(optional)</span>
                    </div>
                    <apex:inputTextarea value="{!approvalComments}"
                        styleClass="comments-textarea"
                        html-placeholder="Add your comments or reason for approving this request..."/>
                    <apex:outputPanel rendered="{!isTwoLevelApproval}">
                        <div class="comments-note">&#9432; These comments will be visible to HR at Level 2.</div>
                    </apex:outputPanel>
                </div>
            </apex:outputPanel>

            <!-- ── APPROVAL COMMENTS — HR ── -->
            <apex:outputPanel rendered="{!isHRLevel}">
                <div class="comments-section-hr">
                    <div class="comments-title-hr">
                        💬 HR Approval Comments
                        <span style="font-size:11px; font-weight:400; color:#6b7280;">(optional)</span>
                    </div>
                    <apex:inputTextarea value="{!approvalComments}"
                        styleClass="comments-textarea comments-textarea-hr"
                        html-placeholder="Add your final approval comments..."/>
                </div>
            </apex:outputPanel>

            <!-- ── ACTION BUTTONS ── -->
            <div class="action-buttons">

                <apex:outputPanel rendered="{!AND(isManagerLevel, NOT(isTwoLevelApproval))}">
                    <apex:commandButton value="✔ Approve"
                        action="{!approve}"
                        styleClass="btn btn-approve"
                        reRender="mainForm"/>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!AND(isManagerLevel, isTwoLevelApproval)}">
                    <apex:commandButton value="✔ Approve and Forward to HR"
                        action="{!approve}"
                        styleClass="btn btn-approve"
                        reRender="mainForm"/>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!isHRLevel}">
                    <apex:commandButton value="✔ Final Approve"
                        action="{!approve}"
                        styleClass="btn btn-approve-final"
                        reRender="mainForm"/>
                </apex:outputPanel>

                <button type="button" class="btn btn-reject"
                        onclick="openRejectModal(); return false;">
                    ✖ Reject
                </button>
            </div>

            <apex:inputHidden value="{!rejectionReason}" id="rejectionReasonHidden"/>
            <apex:commandButton id="rejectBtn"
                value="RejectHidden"
                action="{!reject}"
                style="display:none;"
                reRender="mainForm"/>
            <apex:pageMessages />

        </apex:outputPanel>

        <!-- INVALID LINK -->
        <apex:outputPanel rendered="{!AND(wfh == null, NOT(showSuccess), NOT(showError), NOT(showInfo))}">
            <div class="message-box error-box">
                <span class="icon-large">🔗</span>
                <h3>Invalid Link</h3>
                <p>This WFH request link is invalid or no longer available.</p>
                <p class="close-note">You may close this window.</p>
            </div>
        </apex:outputPanel>

    </div>

    <div class="footer">
        <p>&copy; 2026 Attendance Management System • All Rights Reserved</p>
    </div>

</apex:form>

<!-- REJECTION MODAL -->
<div id="rejectModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-title">❌ Provide Rejection Reason</div>
        <p class="modal-subtitle">Please explain why this WFH request is being rejected. This reason will be shared with the employee.</p>
        <textarea id="rejectionReasonText" class="modal-textarea"
                  placeholder="Enter rejection reason here..."></textarea>
        <p id="reasonError" class="modal-error">⚠️ Rejection reason is required.</p>
        <div class="modal-actions">
            <button type="button" class="btn-modal-cancel" onclick="closeRejectModal()">Cancel</button>
            <button type="button" class="btn-modal-confirm" onclick="confirmReject()">Confirm Reject</button>
        </div>
    </div>
</div>

</div>
</body>
</html>
</apex:page>