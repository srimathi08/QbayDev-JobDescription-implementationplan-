<apex:page controller="ResumePdfController" renderAs="pdf" showHeader="false" applyHtmlTag="false" applyBodyTag="false">
<html>
  <head>
    <style>
      /* Page sizing / margins */
      @page {
        margin-top: 80px;
        margin-bottom: 40px;
        margin-left: 30px;
        margin-right: 30px;

        /* Put header on every page (top-right corner) */
        @top-right {
          content: element(header);
        }
      }

      /* First page: smaller top margin */
      @page :first {
        margin-top: 40px;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
      }

      /* Main content spacing */
      .content-wrapper {
        margin-top: 60px;   /* ensure text clears logo */
        padding-bottom: 8px;
      }

      .content {
        font-size: 12px;
        line-height: 1.5;
      }

      h1, h2 { color: #7a003c; margin-top: 20px; }
      p, li { font-size: 12px; }

      /* Badges (keeps behaving as before) */
      .badge-container {
        position: fixed;
        bottom: 0;
        right: 20px;
        height: 36px;
        line-height: 0;
        z-index: 1000;
        white-space: nowrap;
      }
      .badge-img {
        display: inline-block;
        height: 32px;
        vertical-align: middle;
        margin-left: 6px;
      }
    </style>
  </head>
  <body>

    <!-- Running header element -->
    <div style="position: running(header);">
      <div style="text-align: right; height: 36px;">
        <img src="{!URLFOR($Resource.QBFullLogo)}" style="height:36px; width:auto;" alt="logo"/>
      </div>
    </div>

    <!-- Main Content -->
    <div class="content-wrapper">
      <div class="content">
        <apex:outputText escape="false" value="{!resumeHtml}" />
      </div>
    </div>

    <!-- Fixed Badges -->
    <div class="badge-container" aria-hidden="true">
      <apex:repeat value="{!badgeList}" var="badge">
        <img src="{!URLFOR($Resource[badge])}" class="badge-img" alt="badge"/>
      </apex:repeat>
    </div>

  </body>
</html>
</apex:page>