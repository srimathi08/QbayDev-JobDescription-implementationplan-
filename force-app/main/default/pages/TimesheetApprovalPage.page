<apex:page controller="TimesheetApprovalController" showHeader="false" sidebar="false" standardStylesheets="false" cache="false">
    <html>
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>Timesheet Approval</title>
        <style>
            :root {
                --primary: #4f46e5;
                --primary-hover: #4338ca;
                --success: #10b981;
                --danger: #ef4444;
                --gray-50: #f9fafb;
                --gray-100: #f3f4f6;
                --gray-200: #e5e7eb;
                --gray-300: #d1d5db;
                --gray-400: #9ca3af;
                --gray-500: #6b7280;
                --gray-600: #4b5563;
                --gray-700: #374151;
                --gray-800: #1f2937;
            }
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                background: linear-gradient(135deg, #f0f4ff 0%, #e0e7ff 100%);
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding: 40px 20px;
                color: var(--gray-800);
            }
            .container {
                background: white;
                border-radius: 12px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.08);
                max-width: 650px;
                width: 100%;
                overflow: hidden;
            }
            .header-banner {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
                padding: 12px 20px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                color: white;
            }
            .status-badge {
                display: inline-block;
                padding: 4px 10px;
                border-radius: 4px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.02em;
            }
            .status-pending {
                background-color: rgba(255, 243, 205, 0.2);
                color: #fff3cd;
                border: 1px solid rgba(255, 243, 205, 0.3);
            }
            h1 {
                font-size: 18px;
                font-weight: 700;
                margin: 0;
            }
            .content-area {
                padding: 16px;
            }
            .info-card {
                background-color: var(--gray-50);
                border: 1px solid var(--gray-200);
                border-radius: 8px;
                padding: 12px 16px;
                margin-bottom: 16px;
            }
            .info-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }
            .info-item {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }
            .info-label {
                font-size: 12px;
                font-weight: 600;
                color: var(--gray-500);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }
            .info-value {
                font-size: 14px;
                font-weight: 700;
                color: var(--gray-800);
            }
            .submitted-footer {
                margin-top: 16px;
                padding-top: 16px;
                border-top: 1px solid var(--gray-200);
                font-size: 13px;
                color: var(--gray-500);
                text-align: right;
            }
            h2.section-title {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 16px;
                display: flex;
                align-items: center;
                gap: 8px;
            }
            .table-container {
                border: 1px solid var(--gray-200);
                border-radius: 12px;
                overflow: hidden;
                margin-bottom: 24px;
            }
            table {
                width: 100%;
                border-collapse: collapse;
            }
            th {
                background-color: var(--gray-50);
                color: var(--gray-600);
                padding: 14px 16px;
                text-align: left;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                border-bottom: 1px solid var(--gray-200);
            }
            td {
                padding: 12px 16px;
                border-bottom: 1px solid var(--gray-100);
                font-size: 13px;
                vertical-align: middle;
            }
            tr:last-child td {
                border-bottom: none;
            }
            tr.selected-row {
                background-color: #f5f3ff;
            }
            .checkbox-cell {
                width: 48px;
                text-align: center;
            }
            .hours-cell {
                text-align: right;
                font-weight: 600;
                font-family: 'JetBrains Mono', monospace;
            }
            .reason-input {
                width: 100%;
                padding: 8px 12px;
                border: 1px solid var(--gray-300);
                border-radius: 6px;
                font-size: 13px;
                transition: all 0.2s;
            }
            .reason-input:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
            }
            .pagination-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 12px 16px;
                background-color: white;
                border-top: 1px solid var(--gray-200);
            }
            .page-btn {
                padding: 6px 16px;
                background: white;
                border: 1px solid var(--gray-300);
                border-radius: 6px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s;
                color: var(--gray-700);
            }
            .page-btn:hover:not(:disabled) {
                background-color: var(--gray-50);
                border-color: var(--gray-400);
            }
            .page-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }
            .footer-comment {
                margin: 32px 0;
            }
            .footer-comment textarea {
                width: 100%;
                padding: 16px;
                border: 1px solid var(--gray-300);
                border-radius: 12px;
                min-height: 100px;
                font-family: inherit;
                font-size: 14px;
                transition: all 0.2s;
            }
            .footer-comment textarea:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            }
            .actions-bar {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
            }
            .btn-action {
                padding: 14px 24px;
                border-radius: 10px;
                font-size: 16px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s;
                text-align: center;
                border: none;
            }
            .btn-approve {
                background-color: var(--success);
                color: white;
            }
            .btn-approve:hover {
                filter: brightness(0.95);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
            }
            .btn-reject {
                background-color: var(--danger);
                color: white;
            }
            .btn-reject:hover {
                filter: brightness(0.95);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
            }
            .message-toast {
                padding: 16px;
                border-radius: 10px;
                margin-bottom: 24px;
                text-align: center;
                font-weight: 600;
            }
            .toast-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
            .toast-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
            
            /* Spinner */
            .spinner {
                width: 40px;
                height: 40px;
                border: 4px solid rgba(0, 0, 0, 0.1);
                border-left-color: var(--primary);
                border-radius: 50%;
                animation: spin 1s linear infinite;
                margin: 0 auto;
            }
            @keyframes spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
            
            .btn-action {
                padding: 12px 20px;
                border-radius: 8px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s;
                text-align: center;
                border: none;
                display: inline-block;
                width: auto;
            }
            .btn-approve { background-color: var(--success); color: white; }
            .btn-reject { background-color: var(--danger); color: white; }
            .btn-approve:hover, .btn-reject:hover { filter: brightness(0.9); transform: translateY(-1px); }
        </style>
    </head>
    <body>
        <div class="container">
            <apex:form id="approvalForm">
                <apex:outputPanel id="mainPanel">
                    <!-- Banner -->
                    <div class="header-banner">
                        <h1>Timesheet Approval</h1>
                        <span class="status-badge status-pending">Pending</span>
                    </div>

                    <div class="content-area">
                        <!-- Loading State -->
                        <apex:outputPanel rendered="{!isLoading}">
                            <div style="text-align: center; padding: 60px;">
                                <div class="spinner"></div>
                                <p style="margin-top: 24px; color: var(--gray-500); font-weight: 500;">Retrieving timesheet details...</p>
                            </div>
                        </apex:outputPanel>
                        
                        <apex:outputPanel rendered="{!NOT(isLoading)}">
                            <!-- Toast Messages -->
                            <apex:outputPanel rendered="{!showMessage}">
                                <div class="message-toast {!IF(isSuccess, 'toast-success', 'toast-error')}">
                                    <apex:outputText value="{!message}"/>
                                </div>
                            </apex:outputPanel>
                            
                            <!-- Main Form -->
                            <apex:outputPanel rendered="{!showForm}">
                                <!-- Info Card -->
                                <div class="info-card">
                                    <div class="info-grid" style="grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                                        <div class="info-item">
                                            <span class="info-label">Employee</span>
                                            <span class="info-value">{!employeeName}</span>
                                        </div>
                                        <div class="info-item">
                                            <span class="info-label">Period</span>
                                            <span class="info-value">W{!weekNumber}, {!weekYear}</span>
                                        </div>
                                        <div class="info-item">
                                            <div class="stat-label">HOURS</div>
                                            <div class="stat-value" style="color: #4a4af4;">
                                                <apex:outputText value="{0, number, ###,##0.00}h Logged" >
                                                    <apex:param value="{!totalHours}" />
                                                </apex:outputText>
                                            </div>
                                            <div style="font-size: 11px; color: #666; margin-top: 2px;">
                                                <span style="color: #2e7d32;">B: {!billableHours}h</span> | 
                                                <span style="color: #d32f2f;">NB: {!nonBillableHours}h</span> | 
                                                <span style="color: #7b1fa2;">S: {!shadowHours}h</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="submitted-footer">
                                        Submitted on <apex:outputText value="{0,date,MMM dd, yyyy 'at' hh:mm a}">
                                            <apex:param value="{!submittedDate}"/>
                                        </apex:outputText>
                                    </div>
                                </div>
                                
                                <h2 class="section-title">
                                    <svg style="width:20px;height:20px" viewBox="0 0 24 24"><path fill="currentColor" d="M14,10H19.5L14,4.5V10M5,2H15L21,8V20A2,2 0 0,1,19,22H5C3.89,22 3,21.1 3,20V4C3,2.89 3.89,2 5,2M5,4V20H19V12H14V7H5V4Z" /></svg>
                                    Time Entries (Pending Review)
                                </h2>

                                <div class="table-container">
                                    <apex:actionFunction name="callPartialApprove" action="{!partialApprove}" reRender="mainPanel" status="loadingStatus"/>
                                    <apex:actionFunction name="callPartialReject" action="{!partialReject}" reRender="mainPanel" status="loadingStatus"/>

                                    <!-- Container for Table and Pagination to ensure reliable re-rendering -->
                                    <apex:outputPanel id="tableAndPagination" layout="block">
                                        <table class="entry-table">
                                            <thead>
                                                <tr>
                                                    <th class="checkbox-cell" style="text-align: center; border: none;">
                                                        <apex:actionFunction name="toggleAllAF" action="{!toggleSelectAll}" reRender="tableAndPagination,allSelectedCheck" status="loadingStatus">
                                                            <apex:param name="allChecked" assignTo="{!allSelected}" value=""/>
                                                        </apex:actionFunction>
                                                        <apex:outputPanel id="allSelectedCheck">
                                                            <apex:inputCheckbox value="{!allSelected}" onchange="toggleAllAF(this.checked);"/>
                                                        </apex:outputPanel>
                                                    </th>
                                                    <th>Date</th>
                                                    <th>Project/Task</th>
                                                    <th style="text-align: right;">Hours</th>
                                                    <th style="width: 100px;">Status</th>
                                                    <th style="width: 140px;">Rejection Reason</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <apex:repeat value="{!paginatedEntries}" var="w">
                                                    <tr class="{!IF(w.selected, 'selected-row', '')}">
                                                        <td class="checkbox-cell">
                                                            <apex:inputCheckbox value="{!w.selected}">
                                                                <apex:actionSupport event="onchange" action="{!syncAllSelected}" reRender="tableAndPagination,allSelectedCheck"/>
                                                            </apex:inputCheckbox>
                                                        </td>
                                                        <td style="white-space: nowrap; font-weight: 500;">
                                                            <apex:outputText value="{0,date,MM/dd/yy}">
                                                                <apex:param value="{!w.entry.Date__c}"/>
                                                            </apex:outputText>
                                                        </td>
                                                        <td>
                                                            <div style="color: var(--gray-800); font-weight: 600; font-size: 13px;">{!w.entry.Project__r.Name}</div>
                                                            <div style="color: var(--gray-500); font-size: 11px; line-height: 1.2;">{!w.entry.Tasks__c}</div>
                                                        </td>
                                                        <td class="hours-cell" style="text-align: right; font-weight: 600;">
                                                            <apex:outputText value="{0,number,0.0}">
                                                                <apex:param value="{!w.entry.Total_Hours__c}"/>
                                                            </apex:outputText>
                                                        </td>
                                                        <td>
                                                            <span style="display:inline-block; padding:3px 10px; border-radius:12px; font-size:11px; font-weight:700;
                                                                   background:{!IF(w.entry.Approval_Status__c=='Approved','#d4edda',IF(w.entry.Approval_Status__c=='Rejected','#f8d7da','#fff3cd'))};
                                                                   color:{!IF(w.entry.Approval_Status__c=='Approved','#155724',IF(w.entry.Approval_Status__c=='Rejected','#721c24','#856404'))};">
                                                                {!w.entry.Approval_Status__c}
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <apex:inputTextarea value="{!w.rejectionComment}" 
                                                                                styleClass="reason-input"
                                                                                rows="2"
                                                                                html-placeholder="Reason..."/>
                                                        </td>
                                                    </tr>
                                                </apex:repeat>
                                            </tbody>
                                        </table>

                                        <!-- Pagination Bar — Inside the same re-rendering panel -->
                                        <apex:outputPanel id="paginationPanel" layout="block">
                                            <apex:outputPanel rendered="{!wrapperEntries.size > pageSize}" layout="block">
                                                <div class="pagination-bar" style="margin-top:12px; display:flex; justify-content:space-between; align-items:center; padding:10px; background:var(--gray-50); border-radius:8px;">
                                                    <apex:commandButton value="Previous" action="{!previousPage}" 
                                                                        disabled="{!NOT(hasPrevious)}" 
                                                                        reRender="tableAndPagination,allSelectedCheck"
                                                                        styleClass="page-btn" status="loadingStatus"/>
                                                    <div style="font-size:12px; color:var(--gray-600); font-weight:600;">
                                                        {!startRecord}-{!endRecord} / {!wrapperEntries.size}
                                                    </div>
                                                    <apex:commandButton value="Next" action="{!nextPage}" 
                                                                        disabled="{!NOT(hasNext)}" 
                                                                        reRender="tableAndPagination,allSelectedCheck"
                                                                        styleClass="page-btn" status="loadingStatus"/>
                                                </div>
                                            </apex:outputPanel>
                                        </apex:outputPanel>
                                    </apex:outputPanel>
                                </div><!-- end table-container -->
                                
                                <div class="footer-comment" style="margin-top: 20px;">
                                    <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 6px; color: var(--gray-700);">Overall Comments (Optional)</label>
                                    <apex:inputTextarea value="{!comments}" rows="2" style="width: 100%; border-radius: 8px; border: 1px solid var(--gray-300); padding: 10px; font-family: inherit; font-size: 13px;" html-placeholder="Additional feedback..."/>
                                </div>
                                
                                <div style="display: flex; gap: 12px; margin-top: 16px;">
                                    <apex:commandButton value="Approve Selected" action="{!partialApprove}" styleClass="btn-action btn-approve" style="flex: 1;" reRender="mainPanel" status="loadingStatus"/>
                                    <apex:commandButton value="Reject Selected" action="{!partialReject}" styleClass="btn-action btn-reject" style="flex: 1;" reRender="mainPanel" status="loadingStatus"/>
                                </div>
                            </apex:outputPanel>
                        </apex:outputPanel>
                    </div>
                </apex:outputPanel>
                
                <!-- Advanced Spinner Overlay -->
                <apex:actionStatus id="loadingStatus">
                    <apex:facet name="start">
                        <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.8); backdrop-filter: blur(4px); z-index: 9999; display: flex; align-items: center; justify-content: center;">
                            <div style="text-align: center;">
                                <div class="spinner"></div>
                                <p style="margin-top: 20px; color: var(--primary); font-weight: 700; font-size: 18px;">Processing...</p>
                            </div>
                        </div>
                    </apex:facet>
                </apex:actionStatus>
            </apex:form>
        </div>
    </body>
    </html>
</apex:page>