    <textTemplates>
        <name>EmailBody_Intern</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
    &lt;meta charset=&quot;UTF-8&quot;&gt;
    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
    &lt;title&gt;Internship Offer - Quadrobay Technologies&lt;/title&gt;
&lt;/head&gt;
&lt;body style=&quot;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 20px;&quot;&gt;

&lt;p&gt;Dear &lt;strong&gt;{!$Record.First_Name__c} {!$Record.Last_Name__c}&lt;/strong&gt;,&lt;/p&gt;

&lt;p&gt;We are delighted to extend a warm welcome to you as you embark on an exciting journey with &lt;strong&gt;Quadrobay Technologies Private Limited&lt;/strong&gt; as our valued intern.&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;🎉 Congratulations!&lt;/strong&gt; Your enthusiasm and commitment to learning have earned you a place in our esteemed internship program, and we are thrilled to have you on board.&lt;/p&gt;

&lt;div style=&quot;border-left: 4px solid #1b75ff; background-color: #f7f9fc; padding: 12px 16px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0 0 8px 0;&quot;&gt;&lt;strong&gt;📌 Internship Position:&lt;/strong&gt; {!$Record.Designations__c}&lt;/p&gt;
    &lt;p style=&quot;margin: 0 0 8px 0;&quot;&gt;&lt;strong&gt;⏰ Duration:&lt;/strong&gt; [{!$Record.Internship_Period__c}]&lt;/p&gt;
    &lt;p style=&quot;margin: 0 0 8px 0;&quot;&gt;&lt;strong&gt;🕐 Working Hours:&lt;/strong&gt; 9 hours per day (including 1 hr break)&lt;/p&gt;
    &lt;p style=&quot;margin: 0;&quot;&gt;&lt;strong&gt;📍 Location:&lt;/strong&gt;{!$Record.Place_of_Posting_Base_Location__c}&lt;/p&gt;
&lt;/div&gt;

&lt;p style=&quot;margin: 10px 0;&quot;&gt;During your internship with us, you will have the opportunity to:&lt;/p&gt;
&lt;ul style=&quot;margin: 8px 0 12px 20px; padding: 0;&quot;&gt;
    &lt;li&gt;Work alongside seasoned professionals&lt;/li&gt;
    &lt;li&gt;Engage in hands-on projects and real-world applications&lt;/li&gt;
    &lt;li&gt;Gain valuable insights into the industry&lt;/li&gt;
    &lt;li&gt;Develop your professional skills and knowledge&lt;/li&gt;
&lt;/ul&gt;

&lt;p style=&quot;margin: 10px 0;&quot;&gt;We believe that your skills and fresh perspective will contribute significantly to our team, and we look forward to witnessing your growth and development.&lt;/p&gt;

&lt;p style=&quot;text-align: center; margin: 20px 0;&quot;&gt;
    &lt;a href=&quot;{!$Record.Offer_Letter_Doc_Link__c}&quot;
       target=&quot;_blank&quot;
       style=&quot;background-color: #0066cc; color: #ffffff; padding: 12px 32px; text-decoration: none;
              border-radius: 6px; display: inline-block; font-weight: 600; font-size: 15px;&quot;&gt;
        📄 VIEW YOUR INTERNSHIP OFFER LETTER
    &lt;/a&gt;
&lt;/p&gt;

&lt;div style=&quot;border-left: 4px solid #1b75ff; background-color: #e8f3ff; padding: 12px 16px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0 0 8px 0; font-weight: 600;&quot;&gt;📋 Next Steps - Follow These Instructions:&lt;/p&gt;
    &lt;ol style=&quot;margin: 0 0 0 20px; padding: 0;&quot;&gt;
        &lt;li&gt;&lt;strong&gt;Step 1:&lt;/strong&gt; Click &quot;&lt;strong&gt;View Your Internship Offer Letter&lt;/strong&gt;&quot; button above&lt;/li&gt;
        &lt;li&gt;&lt;strong&gt;Step 2:&lt;/strong&gt; Review all terms and conditions carefully&lt;/li&gt;
        &lt;li&gt;&lt;strong&gt;Step 3:&lt;/strong&gt; Click &quot;&lt;strong&gt;Accept Offer&lt;/strong&gt;&quot; button below&lt;/li&gt;
        &lt;li&gt;&lt;strong&gt;Step 4:&lt;/strong&gt; You&apos;ll be redirected to a confirmation page&lt;/li&gt;
        &lt;li&gt;&lt;strong&gt;Step 5:&lt;/strong&gt; Click &quot;&lt;strong&gt;Complete Onboarding Form&lt;/strong&gt;&quot; to fill your details&lt;/li&gt;
        &lt;li&gt;&lt;strong&gt;Step 6:&lt;/strong&gt; Submit the form to complete the acceptance process&lt;/li&gt;
    &lt;/ol&gt;
&lt;/div&gt;

&lt;p style=&quot;text-align: center; margin: 20px 0;&quot;&gt;
    &lt;a href=&quot;{!$Record.Offer_Acceptance_URL__c}&quot;
       target=&quot;_blank&quot;
       style=&quot;background-color: #28a745; color: #ffffff; padding: 12px 32px; text-decoration: none;
              border-radius: 6px; display: inline-block; font-weight: 600; font-size: 15px;&quot;&gt;
        ✓ ACCEPT INTERNSHIP OFFER
    &lt;/a&gt;
&lt;/p&gt;

&lt;p style=&quot;text-align: center; font-size: 14px; color: #666; margin: 8px 0;&quot;&gt;***&lt;/p&gt;

&lt;div style=&quot;background-color: #fff4d6; border-left: 4px solid #f4b000; padding: 10px 14px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0;&quot;&gt;&lt;strong&gt;⏰ Important:&lt;/strong&gt; Please accept this offer within &lt;strong&gt;one week&lt;/strong&gt; from the date of offer.&lt;/p&gt;
&lt;/div&gt;

&lt;div style=&quot;background-color: #f9fafc; border-left: 4px solid #ffb74d; padding: 12px 16px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0 0 8px 0; font-weight: 600;&quot;&gt;✨ What Happens After You Accept?&lt;/p&gt;
    &lt;p style=&quot;margin: 0 0 8px 0;&quot;&gt;After clicking &quot;&lt;strong&gt;Accept Offer&lt;/strong&gt;&quot;, you will:&lt;/p&gt;
    &lt;ul style=&quot;margin: 0 0 8px 20px; padding: 0;&quot;&gt;
        &lt;li&gt;See a confirmation page with your acceptance details&lt;/li&gt;
        &lt;li&gt;Get immediate access to your onboarding form&lt;/li&gt;
        &lt;li&gt;Be able to complete your onboarding information&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p style=&quot;margin: 0; font-style: italic; color: #555;&quot;&gt;💡 &lt;em&gt;The onboarding form link will only be visible after you accept the offer.&lt;/em&gt;&lt;/p&gt;
&lt;/div&gt;

&lt;div style=&quot;background-color: #e7f1ff; border-left: 4px solid #4a90e2; padding: 12px 16px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0 0 8px 0; font-weight: 600;&quot;&gt;📝 About the Onboarding Form:&lt;/p&gt;
    &lt;p style=&quot;margin: 0 0 8px 0;&quot;&gt;The onboarding form will collect:&lt;/p&gt;
    &lt;ul style=&quot;margin: 0 0 0 20px; padding: 0;&quot;&gt;
        &lt;li&gt;Personal and contact information&lt;/li&gt;
        &lt;li&gt;Educational details and qualifications&lt;/li&gt;
        &lt;li&gt;Bank details for stipend processing&lt;/li&gt;
        &lt;li&gt;Emergency contact information&lt;/li&gt;
        &lt;li&gt;Required documentation&lt;/li&gt;
    &lt;/ul&gt;
&lt;/div&gt;

&lt;p style=&quot;margin: 10px 0;&quot;&gt;This link is unique to you. Please complete all sections at your earliest convenience.&lt;/p&gt;

&lt;div style=&quot;background-color: #f6fdf5; border-left: 4px solid #4caf50; padding: 12px 16px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0 0 8px 0; font-weight: 600;&quot;&gt;✓ After Submitting Your Onboarding Form:&lt;/p&gt;
    &lt;p style=&quot;margin: 0 0 10px 0;&quot;&gt;You will see this confirmation message:&lt;/p&gt;
    &lt;div style=&quot;text-align: center; padding: 12px; background-color: #ffffff; border-radius: 8px; border: 1px solid #e0e0e0;&quot;&gt;
        &lt;div style=&quot;font-size: 28px; margin-bottom: 4px; color: #4caf50;&quot;&gt;✓&lt;/div&gt;
        &lt;div style=&quot;font-size: 17px; font-weight: 600; margin-bottom: 4px; color: #333;&quot;&gt;Onboarding Complete!&lt;/div&gt;
        &lt;div style=&quot;margin-bottom: 4px; color: #555;&quot;&gt;Thank you for completing your onboarding form.&lt;/div&gt;
        &lt;div style=&quot;color: #555;&quot;&gt;Our HR team will be in touch with you shortly.&lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;div style=&quot;background-color: #e8f8ef; border-left: 4px solid #2ecc71; padding: 12px 16px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0 0 8px 0; font-weight: 600;&quot;&gt;🤝 Make the Most of Your Internship:&lt;/p&gt;
    &lt;p style=&quot;margin: 0;&quot;&gt;
        We encourage you to actively participate in team activities, engage with your colleagues, ask questions, and seek guidance. This is your opportunity to learn, grow, and build valuable professional relationships.
    &lt;/p&gt;
&lt;/div&gt;

&lt;p style=&quot;margin: 10px 0;&quot;&gt;Once again, welcome to &lt;strong&gt;Quadrobay Technologies Private Limited&lt;/strong&gt;. We trust that your time here will be both rewarding and enriching. We look forward to a successful and mutually beneficial collaboration.&lt;/p&gt;

&lt;p style=&quot;margin: 10px 0 6px 0;&quot;&gt;If you have any questions or need assistance, please feel free to contact us:&lt;/p&gt;
&lt;p style=&quot;margin: 0 0 12px 0;&quot;&gt;
    &lt;strong&gt;📧 Email:&lt;/strong&gt; &lt;a href=&quot;mailto:hr@quadrobay.com&quot; style=&quot;color: #0066cc; text-decoration: none;&quot;&gt;it-admin@quadrobay.com&lt;/a&gt;&lt;br /&gt;
    &lt;strong&gt;👤 Contact:&lt;/strong&gt; Subathra Mathialagan
&lt;/p&gt;

&lt;div style=&quot;background-color: #fff8e6; border-left: 4px solid #f0ad4e; padding: 10px 14px; margin: 16px 0;&quot;&gt;
    &lt;p style=&quot;margin: 0; text-align: center;&quot;&gt;✉️ You are requested to acknowledge this email as your confirmation!&lt;/p&gt;
&lt;/div&gt;

&lt;p style=&quot;text-align: center; font-weight: bold; font-size: 18px; margin: 16px 0; color: #1b75ff;&quot;&gt;
    🎊 WELCOME TO THE TEAM! 🎊
&lt;/p&gt;

&lt;p style=&quot;margin: 10px 0 0 0;&quot;&gt;Warm Regards,&lt;/p&gt;
&lt;p style=&quot;margin: 0;&quot;&gt;
    &lt;strong&gt;HR Team&lt;/strong&gt;&lt;br /&gt;
    &lt;span style=&quot;color: #667EEA; font-weight: 500;&quot;&gt;Quadrobay Technologies Private Limited&lt;/span&gt;
&lt;/p&gt;

&lt;/body&gt;
&lt;/html&gt;</text>
