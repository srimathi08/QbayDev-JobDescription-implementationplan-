        <name>EmailBody_OnRole</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p style=&quot;margin:0 0 4px 0;&quot;&gt;Dear &lt;strong&gt;{!$Record.First_Name__c} {!$Record.Last_Name__c}&lt;/strong&gt;,&lt;/p&gt;
&lt;p style=&quot;margin:0 0 4px 0;&quot;&gt;
    Hearty Greetings from &lt;strong&gt;Quadrobay Technologies Pvt Ltd!&lt;/strong&gt;
&lt;/p&gt;
&lt;p style=&quot;margin:0 0 4px 0;&quot;&gt;
    We are pleased to extend the following offer of employment to you for the position of
    &lt;strong&gt;{!$Record.Designations__c}&lt;/strong&gt;.
&lt;/p&gt;
&lt;p style=&quot;margin:0 0 6px 0;&quot;&gt;
    &lt;strong&gt;🎉 Congratulations!&lt;/strong&gt; We believe that your knowledge, skills, and experience will be an ideal fit for our team.
&lt;/p&gt;

&lt;!-- Position details card --&gt;
&lt;div style=&quot;background-color:#f8f9fa; padding:8px 10px; border-radius:6px; margin:6px 0; border-left:4px solid #667eea;&quot;&gt;
    &lt;p style=&quot;margin:0 0 2px 0;&quot;&gt;&lt;strong&gt;📌 Position:&lt;/strong&gt; {!$Record.Designations__c}&lt;/p&gt;
    &lt;p style=&quot;margin:0 0 2px 0;&quot;&gt;&lt;strong&gt;⏰ Working Hours:&lt;/strong&gt; Full-time (9 hours per day including 1 hr break)&lt;/p&gt;
    &lt;p style=&quot;margin:0;&quot;&gt;&lt;strong&gt;📍 Location:&lt;/strong&gt; {!$Record.Place_of_Posting_Base_Location__c}&lt;/p&gt;
&lt;/div&gt;

&lt;p style=&quot;margin:4px 0 6px 0;&quot;&gt;
    Please review our offer carefully. It includes important details about your compensation, benefits and employment terms.
&lt;/p&gt;

&lt;!-- Next steps card --&gt;
&lt;div style=&quot;background-color:#e7f3ff; padding:8px 10px; border-radius:6px; border-left:4px solid #0066cc; margin:6px 0;&quot;&gt;
    &lt;p style=&quot;margin:0 0 4px 0; font-weight:600; color:#0066cc;&quot;&gt;
        📋 &lt;strong&gt;Next Steps:&lt;/strong&gt;
    &lt;/p&gt;
    &lt;ol style=&quot;margin:0 0 0 16px; padding:0; line-height:1.4;&quot;&gt;
        &lt;li&gt;Click &quot;&lt;strong&gt;View Offer Letter&lt;/strong&gt;&quot; below to review your offer.&lt;/li&gt;
        &lt;li&gt;After reviewing, click &quot;&lt;strong&gt;Accept Offer&lt;/strong&gt;&quot; to confirm.&lt;/li&gt;
        &lt;li&gt;You’ll be redirected to complete your onboarding form.&lt;/li&gt;
    &lt;/ol&gt;
&lt;/div&gt;

&lt;!-- View Offer Letter Button --&gt;
&lt;p style=&quot;text-align:center; margin:8px 0 4px 0;&quot;&gt;
    &lt;a href=&quot;{!$Record.Offer_Letter_Doc_Link__c}&quot;
       rel=&quot;noopener noreferrer&quot;
       target=&quot;_blank&quot;
       style=&quot;background-color:#0066cc; color:#ffffff; padding:8px 22px; text-decoration:none;
              border-radius:4px; display:inline-block; font-weight:bold; font-size:13px;&quot;&gt;
       📄 VIEW OFFER LETTER
    &lt;/a&gt;
&lt;/p&gt;

&lt;!-- Accept Offer Button --&gt;
&lt;p style=&quot;text-align:center; margin:4px 0 8px 0;&quot;&gt;
    &lt;a href=&quot;{!$Record.Offer_Acceptance_URL__c}&quot;
       rel=&quot;noopener noreferrer&quot;
       target=&quot;_blank&quot;
       style=&quot;background-color:#28a745; color:#ffffff; padding:8px 22px; text-decoration:none;
              border-radius:4px; display:inline-block; font-weight:bold; font-size:13px;&quot;&gt;
       ✓ ACCEPT OFFER
    &lt;/a&gt;
&lt;/p&gt;

&lt;!-- Important note --&gt;
&lt;div style=&quot;background-color:#fff3cd; padding:6px 10px; border-left:4px solid #ffc107; margin:6px 0; border-radius:6px;&quot;&gt;
    &lt;p style=&quot;margin:0;&quot;&gt;
        ⏰ &lt;strong&gt;Important:&lt;/strong&gt; Please accept this offer within &lt;strong&gt;one week&lt;/strong&gt; from the date of offer.
    &lt;/p&gt;
&lt;/div&gt;

&lt;!-- What happens after --&gt;
