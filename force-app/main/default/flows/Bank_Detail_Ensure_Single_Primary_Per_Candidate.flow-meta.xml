    <decisions>
        <description>Checks if other Primary Bank records exist for this Candidate.</description>
        <name>AnyOtherPrimaryFound</name>
        <label>AnyOtherPrimaryFound?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Unset_Other_Primary_Banks</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OtherPrimaryFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Other_Primary_Banks</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Unset_Other_Primary_Banks</targetReference>
            </connector>
            <label>OtherPrimaryFound</label>
        </rules>
    </decisions>
    <decisions>
        <name>ChangedToPrimary</name>
        <label>ChangedToPrimary?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Other_Primary_Banks</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>True_Condition</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Primary_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Primary_Account__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Other_Primary_Banks</targetReference>
            </connector>
            <label>True Condition</label>
        </rules>
    </decisions>
    <environments>Default</environments>
