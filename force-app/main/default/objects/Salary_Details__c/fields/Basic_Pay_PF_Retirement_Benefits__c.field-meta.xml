<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Basic_Pay_PF_Retirement_Benefits__c</fullName>
    <formula>Round(IF(
    BasicPayPF_ManualOverride__c,
    BasicPayPF_Manual__c,
    Gross_Salary__c   *  (Basic_Percentage__c /100)
),0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Basic Pay PF &amp; Retirement Benefits</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
