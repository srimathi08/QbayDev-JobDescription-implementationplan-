<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PF_Contribution_Employer__c</fullName>
    <formula>Round(IF(
(Basic_Pay_PF_Retirement_Benefits__c +
Bucket_Allowances__c +
Other_Allowances_Total__c) / 12 &lt; 15000,

((Basic_Pay_PF_Retirement_Benefits__c +
Bucket_Allowances__c +
Other_Allowances_Total__c) / 12) * 0.13 * 12,

15000 * 0.13 * 12
),0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>PF Contribution Employer</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
