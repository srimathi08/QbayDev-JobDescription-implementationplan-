<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Edit_After_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Start_Date__c) || ISCHANGED(End_Date__c) || ISCHANGED(Leave_Type__c),
    TEXT(PRIORVALUE(Status__c)) = &apos;Approved&apos;
)</errorConditionFormula>
    <errorMessage>Cannot modify approved leave request</errorMessage>
</ValidationRule>
